{
  "name": "voiceshield",
  "version": "1.0.0",
  "description": "Real-time voice transcription with AI scam detection",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "node backend/server.mjs",
    "dev:all": "npm run dev:frontend & npm run dev:backend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "install:all": "npm install && npm install --workspace=frontend && cd backend && pip install -r requirements.txt"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "transcription",
    "voice",
    "scam-detection",
    "aws",
    "react",
    "typescript"
  ]
}
